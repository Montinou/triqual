#!/usr/bin/env bash
# Close one task of an inline plan execution in a single call: run the task's
# test command, keep its full output in the workspace, print the tail, and —
# only if the command succeeded — fold the task's commits into one (when the plan
# runs as a stack: `stack.mjs squash`), move the plan's task ledger
# (`triqual tasks done T<N> --commit <HEAD>`, when the repo is opted in to progress
# tracking) and append the completion line to the workspace ledger
# (`sdd-ledger.md`), once per BASE..HEAD range: a re-run adds no second line.
# A failing command records and moves nothing: the task is not complete.
#
# Tracking paths come from `triqual tasks paths --json`, as in task-start: not
# opted in (`"optedIn": false`, or exit 2) and triqual missing (exit 3, or not on
# PATH, said once) skip the ledger move, and so does a task the ledger
# already shows done (a resumed run). No run ever creates progress.md.
#
# Stacked execution: when the plan's stack state file exists (the file
# `stack.mjs path` prints), the squash runs after the test command passes and
# before the ledger move, so the move and the completion line name the squashed
# HEAD. A squash that stack.mjs refuses (exit 3) fails task-done: nothing is recorded.
# A task already recorded (its task ledger shows it done, or its completion line
# exists for this BASE..HEAD) is not squashed again.
#
# Usage: task-done PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]
#   BASE is the SHA task-start printed; the completion line records BASE..HEAD,
#   and HEAD is the commit the ledger move records.
# Exit: the test command's exit status, the squash's when it fails, or the ledger move's when it fails.
set -euo pipefail

if [ $# -lt 5 ] || [ "$4" != "--" ]; then
  echo "usage: task-done PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]" >&2
  exit 2
fi

plan=$1
n=$2
base=$3
shift 4
sdd="$(cd "$(dirname "$0")" && pwd)"

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }

# Tracking paths: the same block in task-start and task-done. Sets `tracking`
# to committed|local|store (opted in), off (not opted in) or missing, and
# `plans_dir` when opted in. `plan_arg` is what the moves pass as `--plan`: the
# plan's path in `plans_dir` (committed, local), or its bare file name in store
# mode, where there is no ledger file and `triqual tasks` matches by file name.
tracking=missing
plans_dir=
# triqual when it is on PATH, else its cm alias (a machine whose plugin was updated before bootstrap): the same order as
# the progress gate. `cli` stays empty when neither is installed.
cli=
if command -v triqual >/dev/null 2>&1; then
  cli=triqual
elif command -v cm >/dev/null 2>&1; then
  cli=cm
fi
if [ -n "$cli" ]; then
  rc=0
  paths=$("$cli" tasks paths --json 2>/dev/null) || rc=$?
  case $rc in
    0)
      parsed=$(printf '%s' "$paths" | node -e '
        const j = JSON.parse(require("fs").readFileSync(0, "utf8"));
        process.stdout.write(`${j.optedIn === false ? "off" : j.mode || "committed"}\t${j.plansDir || ""}`);
      ')
      tracking=${parsed%%$'\t'*}
      plans_dir=${parsed#*$'\t'}
      ;;
    2) tracking=off ;;
    3 | 127) tracking=missing ;;
    *) echo "task-done: $cli tasks paths --json exited $rc" >&2; exit "$rc" ;;
  esac
fi
if [ "$tracking" = off ] || [ "$tracking" = missing ]; then
  plans_dir=
elif [ ! -f "$plan" ] && [ -f "$plans_dir/$(basename "$plan")" ]; then
  plan="$plans_dir/$(basename "$plan")"
fi
if [ "$tracking" = store ]; then
  plan_arg=$(basename "$plan")
else
  plan_arg="$plans_dir/$(basename "$plan")"
fi

# The task's status in the plan's task ledger, which `triqual tasks status --json`
# locates (empty when it lists no such ledger): a resumed session skips a
# move the ledger already shows instead of failing on it. A listing or ledger
# that cannot be read or parsed also gives empty, so the move is made (and
# `triqual tasks` itself says what is wrong). In store mode there is no ledger
# file (`ledgerPath` is a stored plan path), so the status comes from
# `triqual tasks export --json` instead: the plan whose `name` is the plan file
# name without `.md`. Same in task-start and task-done.
task_status() {
  local ledger_path listing
  if [ "$tracking" = store ]; then
    listing=$("$cli" tasks export --json 2>/dev/null) || listing='{}'
    printf '%s' "$listing" | node -e '
      const fs = require("fs");
      const [name, id] = process.argv.slice(1);
      try {
        const exported = JSON.parse(fs.readFileSync(0, "utf8"));
        const found = (Array.isArray(exported.plans) ? exported.plans : []).find((p) => p && p.name === name);
        const task = found ? (found.tasks || []).find((t) => t && t.id === id) : null;
        if (task) process.stdout.write(String(task.status));
      } catch {
        // unreadable: no status, so the caller makes the move
      }
    ' "$(basename "$plan" .md)" "T$n"
    return 0
  fi
  ledger_path="$plans_dir/$(basename "$plan" .md).tasks.json"
  listing=$("$cli" tasks status --json 2>/dev/null) || listing='[]'
  printf '%s' "$listing" | node -e '
    const fs = require("fs");
    const [ledgerPath, id] = process.argv.slice(1);
    try {
      const listed = JSON.parse(fs.readFileSync(0, "utf8"));
      const entry = Array.isArray(listed) ? listed.find((l) => l && l.ledgerPath === ledgerPath) : null;
      if (!entry) process.exit(0);
      const task = (JSON.parse(fs.readFileSync(entry.ledgerPath, "utf8")).tasks || []).find((t) => t && t.id === id);
      if (task) process.stdout.write(String(task.status));
    } catch {
      // unreadable: no status, so the caller makes the move
    }
  ' "$ledger_path" "T$n"
}

dir=$(node "$sdd/sdd-workspace" "$plan")
log="$dir/task-${n}-tests.log"
ledger="$dir/sdd-ledger.md"

# Render the command the way a person would type it, for the ledger line.
cmd=""
for a in "$@"; do
  case "$a" in
    *[[:space:]\"\;\|\&]*) cmd="$cmd '$a'" ;;
    *) cmd="$cmd $a" ;;
  esac
done
cmd=${cmd# }

rc=0
"$@" > "$log" 2>&1 || rc=$?

tail -n 5 "$log"
if [ "$rc" -ne 0 ]; then
  echo "task-done: test command exited $rc; Task $n NOT recorded (full output: $log)" >&2
  exit "$rc"
fi

# The last output line, for the ledger line; computed before the move, so no
# failure can leave a moved task without its completion line. A quiet test
# command has no output line (and grep's exit 1 must not end the run).
last=$(grep -v '^[[:space:]]*$' "$log" | tail -n 1 || true)
[ -n "$last" ] || last="(no output)"

# A re-run of a task already recorded (a resumed session) must not touch the commits: the squash would fail on a phase
# marked done, or fold the next task's commit into this one. The task is recorded when its task ledger shows it done or
# the workspace ledger holds its completion line for this very BASE..HEAD range (a reopened task has neither: its range
# has new commits and its status is in_progress).
status=
case $tracking in
  missing | off) ;;
  *) status=$(task_status) ;;
esac
range="$(git rev-parse --short=7 "$base")..$(git rev-parse --short=7 HEAD)"
prefix="Task $n: complete (commits $range, "
recorded=0
if [ "$status" = done ]; then
  recorded=1
elif [ -f "$ledger" ] && grep -qF -- "$prefix" "$ledger"; then
  recorded=1
fi

# Stacked execution: one commit per task. The state file's location comes from stack.mjs, never built here; a plan
# stack.mjs cannot locate has no stack. The squash changes the commits, not the tree, so the passed tests still hold.
state_file=$(node "$sdd/stack.mjs" path "$plan" 2>/dev/null) || state_file=
if [ -n "$state_file" ] && [ -f "$state_file" ]; then
  if [ "$recorded" -eq 1 ]; then
    echo "stack: Task $n already recorded; squash skipped"
  else
    rc=0
    squashed=$(node "$sdd/stack.mjs" squash "$plan" "$base" 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "task-done: stack.mjs squash exited $rc: $squashed; Task $n NOT recorded" >&2
      exit "$rc"
    fi
    echo "stack: squash: $squashed"
  fi
fi

head=$(git rev-parse HEAD)
case $tracking in
  missing) echo "tracking: triqual missing (exit 3 or not on PATH): handled as not opted in; no ledger move" ;;
  off) echo "tracking: not opted in; no ledger move" ;;
  *)
    if [ "$status" = done ]; then
      echo "ledger: T$n already done; done skipped"
    else
      rc=0
      moved=$("$cli" tasks done "T$n" --commit "$head" --plan "$plan_arg" 2>&1) || rc=$?
      if [ "$rc" -ne 0 ]; then
        echo "task-done: $cli tasks done T$n exited $rc: $moved; Task $n NOT recorded" >&2
        exit "$rc"
      fi
      echo "ledger move: $moved"
    fi
    ;;
esac

[ -f "$ledger" ] || printf '# SDD ledger — plan: %s\n' "$plan" > "$ledger"
# A re-run for the same commits (a resumed session) adds no second line, and neither does a re-run of a task the ledger
# shows done whose line names the same BASE (HEAD has moved on since: the range now holds the next tasks' commits).
range="$(git rev-parse --short=7 "$base")..$(git rev-parse --short=7 HEAD)"
prefix="Task $n: complete (commits $range, "
if grep -qF -- "$prefix" "$ledger"; then
  echo "ledger: Task $n already complete for $range; completion line kept"
  exit 0
fi
if [ "$status" = done ] && grep -qF -- "Task $n: complete (commits $(git rev-parse --short=7 "$base").." "$ledger"; then
  echo "ledger: Task $n already complete; completion line kept"
  exit 0
fi
line="${prefix}tests: $cmd → $last)"
printf '%s\n' "$line" >> "$ledger"
echo "ledger: $line"
