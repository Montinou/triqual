#!/usr/bin/env node
// Close a reviewed task in one call: squash the task's commits, the `done` move on the tracking ledger, the
// `Task <N>: complete` line, the `task-review` record built from the saved reviewer outputs, and the review progress entry.
//
// Usage: task-close PLAN_FILE N [--provider claude|codex] [--head <sha>]
// Prints, in this order:
//   sha: <sha>                         the squashed (or, for a worktree task, the landed) commit (HEAD when a task closed in place made no
//                                      commit, the tip of the phase branch when a worktree task made none: its complete line reads `<tip>..<tip>`, so a reopen squashes from the tip)
//   record: <recorded|already recorded>   what `triqual role-eval record` said
//
// Inputs, all read before anything is written (a missing or malformed one is an Error and nothing changes):
//   - git: whether BASE..HEAD holds a commit (a task with none needs no reviewer output), and, for a task with commits, that
//     HEAD is the head of the attempt's last `Prep:` line (else exit 3: commits no reviewer saw are never squashed; a reopened
//     task, reviewed by hand, is checked only when it ran task-prep);
//   - the ledger: BASE, the effective tier, `Skipped:` lines, `Round 2: T<N> — light items`, the last `Budget: hunters <tier
//     count> → <used> for T<N>` line of the attempt, and this attempt's `Task <N>:` fix round, parked and blocked lines (an attempt runs from the task's previous
//     `Task <N>: complete` line; `attempt` is 1 + the number of earlier ones);
//   - the saved reviewer outputs `<workspace>/task-<N>-<role>-r<R>.md`, parsed with lib/footer.mjs: the gate
//     (safety-reviewer) and the spec reviewer, of the lowest round saved for each role. Heavy and standard tasks need both;
//     a light task needs the gate, and the spec reviewer only when its Round 2 had light items; after `Skipped: hunters and
//     safety gate` the safety checklist sits in the spec output and no gate output is needed; a task with no commits needs
//     none. Candidate verdicts are read from every saved spec reviewer output;
//   - the hunters' `task-<N>-candidates-<category>.md` (heavy tasks, unless hunters were skipped; a Budget line above the tier's
//     count adds the categories whose files exist, and one below it keeps only the first <used>, files first, none of the
//     others recorded failed): a missing or blank file is a hunter recorded `failed`; every candidate id a file holds needs a verdict in a spec footer, and every candidate a footer
//     names needs a hunter file that holds it;
//   - the hunter model: with `--provider codex` the Codex routing value of `hunter`; otherwise (claude, the default) the `model:`
//     line of agents/hunter.md in the roles plugin's installPath from ~/.claude/plugins/installed_plugins.json.
//
// A worktree task (task-open --worktree) is one with --head <sha>, a branch `wt/<plan stem>-t<N>` (--head then defaults to its tip) or
// a `Landed:` line of this attempt. Its commits are reviewed in the worktree (task-prep --head), so the head the last `Prep:` line
// names is the worktree's, and the close LANDS the task instead of squashing:
//   - --head must be the tip of the task's branch: the close removes the branch, so a --head behind the tip (commits no reviewer saw
//     come after it) is refused (exit 3);
//   - it refuses (exit 3, and no `Error:` line: it is a wait, not a failure) while an earlier task of the phase is not `done` or
//     `dropped` in the tracking ledger (not opted in: has no `Task <M>: complete` line);
//   - it skips the landing when a `Landed: T<N> <sha>` line stands (no undo has followed it); the closed head is then that sha, whatever
//     --head says, and the reviewed-head check above is not repeated (it ran before the landing). A landing that stands is trusted
//     only after two checks, since a crash can leave it half done: the sha must still be an ancestor of the active phase branch
//     (else exit 3: the undo of the landing was cut short, nothing is closed), and its Test files must have passed (a ledger line
//     `Tested: T<N> <sha>` written after a green run): without that line the Test files run again at the phase tip, and a failure is
//     undone as below (a landing that is not the phase tip and has no `Tested:` line is refused, exit 3);
//   - else it needs HEAD on the active phase branch of the stack (a detached HEAD or another branch is exit 3, as for `stack.mjs
//     squash`), a clean tree, and Test paths that name files inside the repository (no glob, nothing outside it), merges the task's head
//     into the phase tip (`git merge-tree --write-tree` with the task's BASE as merge base; BASE must be an ancestor of the head), makes
//     ONE commit of the merged tree on the phase tip (`git commit-tree`, the task's first commit's message and author), moves the phase
//     branch to it (`git reset --keep`), appends `Landed: T<N> <sha>` and, for the head check of a rerun after the close, `Prep: T<N> r<R>
//     <sha>` (R: the round of the attempt's last `Prep:` line; none when the attempt has none), and runs the task's plan `Test:` files
//     with `node --test` at that tip (a file that is not there fails, so zero files run is never a pass; the run is cut off after
//     TRIQUAL_LANDING_TEST_TIMEOUT_MS, default 600000, and a timeout is a failure; the output goes to
//     `<workspace>/task-<N>-landing-test.log`), then appends `Tested: T<N> <sha>`. A crash after the reset and before the `Landed:`
//     line leaves the phase tip at a commit that is already the landing of the head: the rerun recognises it (same tree, message and
//     author) and records it instead of landing a second, empty commit;
//   - a conflict or a failing test is undone: `git reset --keep <previous tip>`, the ledger lines `BASE: T<N> <previous tip>` and
//     `Task <N>: landing conflict — re-run sequential` (one write), the file `<workspace>/task-<N>-undone` (reviewer and hunter outputs
//     older than it belong to the undone attempt and are never counted), `triqual tasks rework`, the worktree and its branch removed,
//     exit 3. The ledger of the sequential re-run starts after the undo line: the Prep lines, fix rounds and budget of the undone
//     attempt are not counted. A rerun after an undo that died before the clean-up finishes the clean-up (and writes the marker when it
//     is missing) and exits 3; so does one after an undo that died between its reset and its ledger lines (the landing has no `Tested:`
//     line and the phase tip is its parent). After an undo, a close is refused (exit 3) until the sequential re-run has a `Prep:` line:
//     the worktree and its branch are gone, so a close would squash nothing and mark the task done with none of its work;
//   - after the record and the entry it removes the worktree (`git worktree remove --force` once no tracked file of it has uncommitted
//     changes: untracked files, such as an install's output, are dropped and named on stderr (up to 200, then `, and N more`); tracked changes are an Error and exit
//     1 after everything is recorded, and a rerun repeats only the removal) and its branch (`git branch -D`) and checks that
//     `git worktree list` no longer shows it; a rerun repeats only what is left.
//
// The wait above, and the whole landing, apply to worktree tasks only: a task closed in place (sequential, `stack.mjs squash`) is
// closed in the order the controller runs it, as before.
//
// Ledger line forms this script adds to the plan's list (SKILL.md's ledger vocabulary is outside this task's files, so the form is
// recorded here): `Tested: T<N> <sha>`.
//
// Then, in this order: `stack.mjs squash PLAN BASE`, `triqual tasks done T<N> --commit <sha>` (not when the ledger already
// shows the task done), the complete line, `triqual role-eval record`, and the progress entry (store mode: `tracking add
// --commit <sha>`; local mode: `tracking write entry`; committed mode or not opted in: none).
//
// A rerun is a resume: when the task's last ledger line is its complete line (an `Error: task-close T<N>` line may follow it),
// the squash, the `done` move and the line are skipped, the attempt of that line is reused, and the record and the entry are
// made again if they are missing (record: already recorded). The entry is looked up before it is added, in store mode with
// `tracking log` (a failed lookup is an Error) and in local mode in the progress file, so a first run that failed after the
// complete line still gets its entry on the rerun, and exactly once.
//
// Reopened tasks (attempt 2 and later) squash from the parent of the commit the previous attempt's complete line closed at (for a task
// closed in place that is its BASE; a landed worktree task's BASE is the phase tip from when it opened, older than the tip it landed
// on, so it is not), and the complete line shows that parent. A previous commit that is not in the history of HEAD is an Error.
// The saved outputs carry the round, not the attempt, so each close leaves a marker file
// `<workspace>/task-<N>-closed-<attempt>`, and an attempt after the first takes only the outputs (gate, spec, hunters) saved
// after the marker of the attempt before. A stale or missing one is an Error naming it: attempt 1's counts are never reused.
//
// Exit codes: 0 ok, 2 usage / no such plan file / bad --head, 3 refused (linked worktree, unknown task, no BASE, commits after the last
// Prep, a move or the squash refused, an earlier task not landed, an undone landing), 1 any other failure. A failure appends `Error: task-close T<N> — exit <code> — <cause>` to the ledger.
//
// Dynamic imports only: the file has no extension, so Node may load it as CommonJS or as an ES module depending on the
// nearest package.json.
(async () => {
  const { existsSync, readFileSync, readdirSync, realpathSync, statSync, writeFileSync } = await import('node:fs');
  const { homedir } = await import('node:os');
  const { basename, dirname, join, resolve } = await import('node:path');
  const { pathToFileURL } = await import('node:url');
  const scripts = dirname(realpathSync(process.argv[1]));
  const load = (...parts) => import(pathToFileURL(join(scripts, ...parts)).href);
  const common = await load('lib', 'task-common.mjs');
  const { FooterError, parseFooter, candidateIds } = await load('lib', 'footer.mjs');
  const { codexRoleModel } = await load('..', '..', '..', 'cli', 'lib', 'agents.mjs');
  const { validateRecord, TIERS, CATEGORIES } = await load('..', '..', '..', 'cli', 'lib', 'role-eval.mjs');
  const { ScriptError, EXIT_OTHER, EXIT_USAGE, EXIT_REFUSED } = common;

  const STEP = 'task-close';
  const USAGE = 'usage: task-close PLAN_FILE N [--provider claude|codex] [--head <sha>]';
  const PROVIDERS = ['claude', 'codex'];
  const SEVERITIES = ['critical', 'important', 'minor'];
  const NAMED_UNTRACKED_MAX = 200; // the dropped untracked files stderr names; the rest are counted
  const zero = () => ({ critical: 0, important: 0, minor: 0 });
  const sum = (counts) => SEVERITIES.reduce((total, s) => total + counts[s], 0);
  const rank = (tier) => TIERS.indexOf(tier); // TIERS runs heavy first: the lower index is the higher tier
  const readText = (file, what) => {
    try {
      return readFileSync(file, 'utf8');
    } catch (e) {
      throw new ScriptError(EXIT_OTHER, `cannot read ${what} ${file}: ${e.code ?? e.message}`);
    }
  };

  // The hunter model of the default provider: the `model:` line of the roles plugin's hunter agent file.
  const claudeHunterModel = () => {
    const installed = join(homedir(), '.claude', 'plugins', 'installed_plugins.json');
    let plugins;
    try {
      plugins = JSON.parse(readText(installed, 'the plugin registry')).plugins ?? {};
    } catch (e) {
      if (e instanceof ScriptError) throw e;
      throw new ScriptError(EXIT_OTHER, `${installed} is not JSON`);
    }
    const installs = Object.entries(plugins).filter(([key]) => key.startsWith('roles@')).flatMap(([, list]) => list ?? [])
      .filter((entry) => typeof entry?.installPath === 'string')
      .sort((a, b) => String(b.lastUpdated ?? '').localeCompare(String(a.lastUpdated ?? '')));
    if (installs.length === 0) throw new ScriptError(EXIT_OTHER, `${installed} lists no install of the roles plugin`);
    const agent = join(installs[0].installPath, 'agents', 'hunter.md');
    const front = /^---\r?\n([\s\S]*?)\r?\n---/.exec(readText(agent, 'the hunter agent file'));
    const line = front && /^model:\s*(.+?)\s*$/m.exec(front[1]);
    if (!line) throw new ScriptError(EXIT_OTHER, `${agent} has no model: line in its frontmatter`);
    return line[1].replace(/^(["'])(.*)\1$/, '$2');
  };

  let n = null;
  let workspace;
  try {
    const positional = [];
    let provider = 'claude';
    let headArg = null;
    const argv = process.argv.slice(2);
    for (let i = 0; i < argv.length; i++) {
      if (argv[i] === '--provider') {
        if (i + 1 >= argv.length) throw new ScriptError(EXIT_USAGE, '--provider needs claude or codex');
        provider = argv[++i];
      } else if (argv[i].startsWith('--provider=')) provider = argv[i].slice('--provider='.length);
      else if (argv[i] === '--head') {
        if (i + 1 >= argv.length) throw new ScriptError(EXIT_USAGE, '--head needs a sha');
        headArg = argv[++i];
      } else if (argv[i].startsWith('--head=')) headArg = argv[i].slice('--head='.length);
      else if (argv[i].startsWith('--')) throw new ScriptError(EXIT_USAGE, `unknown option: ${argv[i]}`);
      else positional.push(argv[i]);
    }
    n = common.taskNumber(positional[1]);
    if (positional.length !== 2 || n === null) throw new ScriptError(EXIT_USAGE, USAGE);
    if (!PROVIDERS.includes(provider)) throw new ScriptError(EXIT_USAGE, `--provider is ${PROVIDERS.join(' or ')}, not ${provider}`);
    const plan = positional[0];

    common.assertMainCheckout();
    workspace = common.workspaceOf(plan);
    const planTask = common.readPlanTask(plan, n);
    const planName = basename(plan);
    const stem = planName.replace(/\.md$/, '');

    // ---- read everything: nothing is written before the record is built and valid ----
    const ledger = common.ledgerLines(workspace);
    const baseLine = common.lastBase(ledger, n);
    if (baseLine === null) throw new ScriptError(EXIT_REFUSED, `no BASE recorded for T${n}: run task-open first`);
    // The ledger's word reaches git only as a resolved sha: a value that starts with `-` (or names no commit) is an Error, never an option.
    const base = common.commitOf(baseLine);
    if (base === null) throw new ScriptError(EXIT_OTHER, `the BASE of T${n} (${baseLine}) is not a commit`);

    // This attempt's window of the ledger: after the task's previous complete line, up to the line being reused (if any).
    // The tracking row is read first: a task that was reopened since its complete line is not `done`, so it is no resume.
    const state = common.taskState(planName, n);
    const completeAt = ledger.flatMap((l, i) => (l.startsWith(`Task ${n}: complete (commits `) ? [i] : []));
    const lastComplete = completeAt.at(-1) ?? -1;
    // A rerun resumes unless a line after the complete line is new work on THIS task. Lines the controller and the
    // orchestrator write around a failed close are not (SKILL.md, The Thin Controller): this step's own `Error:` lines,
    // the task's `Ruling:`, `awaiting landing` and `minor (deferred)` lines, and every line that names no T<N> or
    // `Task <N>:` (`Orchestrator:`, `Denied by policy:`, `Ruling:`, `RateLimit:`, other tasks' lines). Everything else
    // that names this task (`Prep:`, `BASE:`, `Task <N>: fix round`, `Task <N>: reopened`, ...) marks a reopen. The `Landed:` line of
    // a landing and the `Prep:` line it writes at the landed sha are part of the attempt they landed.
    const ownScope = new RegExp(`^(?:Task ${n}: |(?:Prep|BASE|Tier|Tier raised|Review|Re-review|Round [12]|Skills): T${n}\\b|Error: [a-z-]+ T${n} |Budget: .* for T${n} )`);
    const ownQuiet = new RegExp(`^(?:Error: ${STEP} T${n} |Landed: T${n} |Tested: T${n} |Task ${n}: (?:Ruling: |awaiting landing$|minor \\(deferred\\)))`);
    // The landing writes a `Prep:` line at the landed sha (see the header): it belongs to the attempt it landed, not to a reopen.
    const landedShas = new Set(ledger.flatMap((l) => { const m = new RegExp(`^Landed: T${n} (\\S+)\\s*$`).exec(l); return m ? [m[1]] : []; }));
    const landingPrep = (l) => { const m = new RegExp(`^Prep: T${n} r\\d+ (\\S+)\\s*$`).exec(l); return m !== null && landedShas.has(m[1]); };
    const notNewWork = (l) => ownQuiet.test(l) || landingPrep(l) || !ownScope.test(l);
    const resumed = lastComplete >= 0 && (state === null || state.status === 'done')
      && ledger.slice(lastComplete + 1).every(notNewWork);
    const earlier = resumed ? completeAt.slice(0, -1) : completeAt;
    const attempt = earlier.length + 1;
    const attemptLines = ledger.slice((earlier.at(-1) ?? -1) + 1, resumed ? lastComplete : ledger.length);
    // A landing that was undone starts the task over (sequential): what the undone attempt wrote before the undo line (Prep lines,
    // fix rounds, a Budget line, the Landed line itself) is not this attempt's.
    const undoneAt = common.lastUndoIndex(attemptLines, n);
    const window = attemptLines.slice(undoneAt + 1);
    const count = (prefix) => window.filter((l) => l.startsWith(prefix)).length;

    const { optedIn, mode, progress } = common.tracking();
    const tier = state?.effectiveTier ?? common.ledgerTier(ledger, n) ?? planTask.task.tier ?? null;
    if (tier === null) {
      throw new ScriptError(EXIT_OTHER, `no tier for T${n}: not in the tracking ledger, in a Tier: line of the ledger or in the plan (write 'Tier: T${n} <tier>' first)`);
    }
    const declaredTier = planTask.task.tier;
    const skippedHunters = ledger.some((l) => /^Skipped: hunters\b/.test(l));
    const skippedGate = ledger.some((l) => l.startsWith('Skipped: hunters and safety gate'));
    const lightItems = window.map((l) => new RegExp(`^Round 2: T${n} — light items (\\d+)$`).exec(l)).filter(Boolean).at(-1);

    // Whether the task has commits is git's word, never a ledger line: a `Review: T<N> — no commits` line goes stale the
    // moment the implementer commits. A resumed close counts up to the commit it squashed to, not to a HEAD later tasks moved.
    let resumedSha = null;
    let resumedNoCommits = false;
    if (resumed) {
      const short = /commits ([0-9a-f]{7,40})\.\.([0-9a-f]{7,40})[,)]/.exec(ledger[lastComplete]);
      resumedSha = short && common.commitOf(short[2]);
      if (!resumedSha) throw new ScriptError(EXIT_OTHER, `cannot resolve the commit of the line: ${ledger[lastComplete]}`);
      // A close that made no commit shows `<sha>..<sha>`; counting BASE..<sha> would say otherwise for a worktree task, which closes at
      // the phase tip, later than its BASE.
      resumedNoCommits = common.commitOf(short[1]) === resumedSha;
    }
    // A worktree task is built and reviewed in its worktree and lands at close. Its head is the landed commit once it landed, else
    // --head, else the tip of its branch; any other task closes at HEAD of the main checkout.
    const wt = common.worktreeOf(planName, n);
    const landed = common.lastLanded(window, n);
    const wtTip = common.commitOf(`refs/heads/${wt.branch}`);
    const worktreeTask = headArg !== null || wtTip !== null || landed !== null;
    let head;
    if (landed !== null) head = common.commitOf(landed);
    else if (headArg !== null) head = common.commitOf(headArg);
    else head = wtTip ?? common.commitOf('HEAD');
    if (head === null) {
      throw landed !== null ? new ScriptError(EXIT_OTHER, `cannot resolve the landed commit ${landed}`)
        : new ScriptError(headArg !== null ? EXIT_USAGE : EXIT_OTHER, headArg !== null ? `bad --head: ${headArg}` : 'cannot resolve HEAD');
    }
    // The file that dates an undone landing's outputs (see below, and `undo`).
    const undoneMarker = join(workspace, `task-${n}-undone`);
    // An undone landing stays undone: after the undo line (the sequential re-run starts there) nothing is closed until the re-run has a
    // `Prep:` line of its own, since the worktree and its branch are gone and a close would squash no commit and mark the task done with
    // none of its work. When the undo died before its clean-up finished (the worktree or its branch is still there, or the marker is
    // missing), finish the clean-up first: the task goes back to be re-run sequential, as the undo meant. Either way: refuse.
    if (!resumed && undoneAt >= 0 && !window.some((l) => new RegExp(`^Prep: T${n} `).test(l))) {
      const leftover = wtTip !== null || common.registeredWorktrees().includes(wt.path);
      if (leftover) {
        if (!existsSync(undoneMarker)) writeFileSync(undoneMarker, `${base}\n`);
        if (state && state.status === 'in_review') common.taskMove('rework', n, plan);
        common.removeWorktree(wt, { force: true });
      }
      throw new ScriptError(EXIT_REFUSED, leftover
        ? `the landing of T${n} was undone earlier and its clean-up did not finish; it has now: re-run T${n} sequential (task-open without --worktree, implement, task-prep)`
        : `the landing of T${n} was undone and none of its work is on the phase branch: re-run T${n} sequential (task-open without --worktree, implement, task-prep) before closing it`);
    }
    // --head names the commit that was reviewed; the close throws the branch away, so a branch that has moved on is refused.
    if (!resumed && landed === null && wtTip !== null && head !== wtTip) {
      throw new ScriptError(EXIT_REFUSED, `--head ${head.slice(0, 7)} is not the tip of ${wt.branch} (${wtTip.slice(0, 7)}): the commits after it would be thrown away with the branch; review the tip with task-prep --head, or close without --head`);
    }
    // Landing is in plan order: a task whose turn has not come waits (exit 3, no Error line: nothing failed).
    if (worktreeTask && !resumed && landed === null) {
      const waiting = common.earlierUnfinished(plan, planName, n, ledger);
      if (waiting.length > 0) {
        throw new ScriptError(EXIT_REFUSED, `T${n} waits for ${waiting.map((m) => `T${m}`).join(', ')}: worktree tasks land in plan order, close it again once ${waiting.length === 1 ? 'it is' : 'they are'} done or dropped`, { logged: false });
      }
    }
    const noCommits = resumed ? resumedNoCommits : Number(common.git(['rev-list', '--count', `${base}..${head}`])) === 0;
    // The commits a close squashes are the commits a reviewer saw: the last `Prep:` head of the attempt is HEAD. A reopened
    // task (attempt 2 and later) may be reviewed by hand (SKILL step 8), so it is checked only when it ran task-prep.
    // A landing that stands passed this check before it was written (its sha is the head now), so only a review after it is checked:
    // a `Prep:` line after the `Landed:` line must name the landed sha (the landing writes one), anything else is commits no reviewer saw.
    if (!resumed && !noCommits) {
      const landedAt = landed === null ? -1 : window.findLastIndex((l) => l.trim() === `Landed: T${n} ${landed}`);
      const last = common.prepsOf(window, n).filter((p) => p.index > landedAt).at(-1) ?? null;
      if (last === null && attempt === 1 && landed === null) {
        throw new ScriptError(EXIT_REFUSED, `T${n} has commits and no Prep line: run task-prep and review them first`);
      }
      if (last !== null && last.head !== head) {
        throw new ScriptError(EXIT_REFUSED, `T${n} has commits after the last review (Prep r${last.round} at ${last.head.slice(0, 7)}, HEAD ${head.slice(0, 7)}): run task-prep --fix-round and review them first`);
      }
    }
    const needGate = !noCommits && !skippedGate;
    const needSpec = !noCommits && (skippedGate || tier !== 'light' || (lightItems !== undefined && Number(lightItems[1]) > 0));

    // Attempt 2 and later: only outputs saved after the previous attempt's close marker belong to this attempt. The same goes for the
    // outputs saved before the undo of a landing (`<workspace>/task-<N>-undone`): they review the undone worktree attempt.
    const markerOf = (a) => join(workspace, `task-${n}-closed-${a}`);
    let cutoff;
    let cutoffFile = null;
    const mtimeOf = (file) => {
      try {
        return statSync(file).mtimeMs;
      } catch (e) {
        throw new ScriptError(EXIT_OTHER, e.code === 'ENOENT'
          ? `T${n} attempt ${attempt}: ${file} is missing, so this attempt's outputs cannot be told from attempt ${attempt - 1}'s`
          : `cannot read ${file}: ${e.code ?? e.message}`);
      }
    };
    const cutoffOf = () => {
      if (cutoff === undefined) {
        cutoff = null;
        for (const file of [attempt > 1 ? markerOf(attempt - 1) : null, existsSync(undoneMarker) ? undoneMarker : null]) {
          if (file === null) continue;
          const at = mtimeOf(file);
          if (cutoff === null || at >= cutoff) {
            cutoff = at;
            cutoffFile = file;
          }
        }
      }
      return cutoff;
    };
    const isStale = (file) => cutoffOf() !== null && statSync(file).mtimeMs <= cutoffOf();
    const staleWhy = () => (cutoffFile === undoneMarker
      ? `the undone landing (older than ${undoneMarker})` : `attempt ${attempt} started (older than ${markerOf(attempt - 1)})`);

    // The saved outputs of a role, by round; the first (lowest round) one carries the review's counts.
    const saved = readdirSync(workspace);
    const outputsOf = (role) => saved
      .map((name) => new RegExp(`^task-${n}-${role}-r(\\d+)\\.md$`).exec(name)).filter(Boolean)
      .filter(([name]) => !isStale(join(workspace, name)))
      .sort((a, b) => Number(a[1]) - Number(b[1]))
      .map(([name]) => {
        const text = readText(join(workspace, name), 'the saved reviewer output');
        try {
          const footer = parseFooter(text);
          if (footer.role !== role) throw new FooterError(`the footer is for ${footer.role}, not ${role}`);
          return footer;
        } catch (e) {
          if (e instanceof FooterError) throw new ScriptError(EXIT_OTHER, `${name}: ${e.message}`);
          throw e;
        }
      });
    const required = (role) => {
      const outputs = outputsOf(role);
      if (outputs.length === 0) {
        const after = attempt > 1 ? ` in attempt ${attempt} (saved after ${markerOf(attempt - 1)})`
          : existsSync(undoneMarker) ? ` after the undone landing (saved after ${undoneMarker})` : '';
        throw new ScriptError(EXIT_OTHER, `no saved ${role} output for T${n}${after}: expected ${join(workspace, `task-${n}-${role}-r1.md`)} with the v1 footer`);
      }
      return outputs;
    };
    const gate = needGate ? required('safety-reviewer')[0] : null;
    const specs = needSpec ? required('spec-reviewer') : [];
    const spec = specs[0] ?? null;

    // The hunters sent: a task review sends none at any tier (they run at the phase review only), so the tier's pick is empty;
    // the only hunters a task records are the ones the task's last `Budget: hunters <tier count> → <used> for T<N>` line of this
    // attempt names: the categories whose candidates files exist, the first <used> of them. Hunters the budget did not send are
    // not recorded as failed.
    const tierPick = [];
    const budget = window.map((l) => new RegExp(`^Budget: hunters (\\d+) → (\\d+) for T${n}\\b`).exec(l)).filter(Boolean).at(-1);
    let categories = skippedHunters || noCommits ? [] : tierPick;
    if (budget && !skippedHunters && !noCommits) {
      const withFile = CATEGORIES.filter((category) => {
        const file = join(workspace, `task-${n}-candidates-${category}.md`);
        return existsSync(file) && !isStale(file);
      });
      const used = Number(budget[2]);
      if (used > tierPick.length) {
        categories = [...tierPick, ...withFile.filter((category) => !tierPick.includes(category))];
        if (categories.length < used) {
          throw new ScriptError(EXIT_OTHER, `${budget[0]} names ${used} hunter${used === 1 ? '' : 's'}, but ${withFile.length} candidates file${withFile.length === 1 ? '' : 's'} exist${withFile.length === 1 ? 's' : ''} for T${n} (a hunter that found nothing leaves a blank file)`);
        }
      } else {
        categories = [...tierPick.filter((category) => withFile.includes(category)), ...tierPick.filter((category) => !withFile.includes(category))].slice(0, used);
      }
    }

    // The hunters: one entry per category sent; the verdicts come from the spec reviewer's footers.
    const verdicts = new Map(specs.flatMap((s) => s.candidates).map((c) => [c.id, c]));
    const model = categories.length === 0 ? null : provider === 'codex' ? codexRoleModel('hunter') : claudeHunterModel();
    const known = new Set();
    const hunters = categories.map((category) => {
      const file = join(workspace, `task-${n}-candidates-${category}.md`);
      let text = null;
      try {
        text = readFileSync(file, 'utf8');
      } catch (e) {
        if (e.code !== 'ENOENT') throw new ScriptError(EXIT_OTHER, `cannot read the candidates file ${file}: ${e.code ?? e.message}`);
      }
      if (text !== null && isStale(file)) {
        cutoffOf();
        throw new ScriptError(EXIT_OTHER, `${basename(file)} is from before ${staleWhy()}: run the hunter again or remove the file`);
      }
      if (text === null || text.trim() === '') {
        return { category, model, failed: true, candidates: 0, confirmed: zero(), refuted: 0, duplicateCandidate: 0, duplicateReview: 0 };
      }
      const ids = candidateIds(text, category);
      const hunter = { category, model, failed: false, candidates: ids.length, confirmed: zero(), refuted: 0, duplicateCandidate: 0, duplicateReview: 0 };
      for (const id of ids) {
        known.add(id);
        const verdict = verdicts.get(id);
        if (!verdict) throw new ScriptError(EXIT_OTHER, `the spec reviewer's footer gives no verdict for candidate ${id} of ${basename(file)}`);
        if (verdict.verdict === 'confirmed') hunter.confirmed[verdict.severity] += 1;
        else if (verdict.verdict === 'refuted') hunter.refuted += 1;
        else if (verdict.verdict === 'duplicate-candidate') hunter.duplicateCandidate += 1;
        else hunter.duplicateReview += 1;
      }
      return hunter;
    });
    const stray = [...verdicts.keys()].find((id) => !known.has(id));
    if (stray !== undefined) throw new ScriptError(EXIT_OTHER, `the spec reviewer's footer names candidate ${stray}, which no hunter file has`);

    const record = {
      v: 2,
      at: new Date().toISOString().replace(/\.\d+Z$/, 'Z'),
      provider,
      task: `T${n}`,
      kind: 'task-review',
      attempt,
      tier,
      declaredTier,
      // A tierless task counts as standard here: the contract (SKILL.md, task-review) and validateRecord both say so.
      raised: rank(tier) < rank(declaredTier ?? 'standard'),
      hunters,
      gate: { findings: gate ? sum(gate.findings) : 0 },
      spec: { ran: spec !== null, confirmed: spec ? { ...spec.findings } : zero() },
      fixRounds: count(`Task ${n}: fix round `),
      blocked: count(`Task ${n}: blocked at fix round `) > 0,
      coordinator: planTask.task.role === 'coordinator',
    };
    const valid = validateRecord(record);
    if (!valid.ok) throw new ScriptError(EXIT_OTHER, `the task-review record is invalid: field ${valid.field}`);
    const parked = count(`Task ${n}: parked`);

    // The landing of a worktree task (see the header). Everything that can refuse runs before anything is written.
    const preflight = () => {
      const phaseBranch = common.activePhaseBranch(plan);
      const current = common.exec('git', ['symbolic-ref', '--quiet', '--short', 'HEAD']);
      if (current.status !== 0) throw new ScriptError(EXIT_REFUSED, `HEAD is detached, not the active phase's branch ${phaseBranch}: nothing to land on`);
      if (current.stdout.trim() !== phaseBranch) {
        throw new ScriptError(EXIT_REFUSED, `HEAD is on ${current.stdout.trim()}, not the active phase's branch ${phaseBranch}: nothing to land on`);
      }
      const tip = common.commitOf('HEAD');
      if (tip === null) throw new ScriptError(EXIT_REFUSED, 'HEAD of the main checkout is not on a commit: nothing to land on');
      if (common.git(['status', '--porcelain', '--untracked-files=no']) !== '') {
        throw new ScriptError(EXIT_REFUSED, 'the working tree is not clean: commit or stash the changes to tracked files first');
      }
      const tests = common.testPaths(planTask);
      if (tests.length === 0) throw new ScriptError(EXIT_REFUSED, `T${n} has no Test: path in the plan: a landing runs none, and a landing that tests nothing is no landing`);
      const root = common.git(['rev-parse', '--show-toplevel']);
      const problem = tests.map((t) => common.testPathProblem(root, t)).find((why) => why !== null);
      if (problem) throw new ScriptError(EXIT_REFUSED, `T${n}: ${problem}`);
      return { tip, tests, root, timeout: common.landingTestTimeoutMs() };
    };
    // The undo: the phase branch back to `before`, the fresh BASE and the undo line in ONE write, the marker that dates the undone
    // attempt's outputs, the task moved back, the worktree and its branch removed.
    // `reset: false`: the phase branch is already at `before` (an undo that died after its reset and before its ledger lines).
    const undo = (why, before, { reset = true } = {}) => {
      if (reset) common.git(['reset', '--keep', before]);
      common.appendLedger(workspace, `BASE: T${n} ${before}`, common.UNDONE_LINE(n));
      writeFileSync(undoneMarker, `${before}\n`);
      if (state) common.taskMove('rework', n, plan);
      common.removeWorktree(wt, { force: true });
      throw new ScriptError(EXIT_REFUSED, `${why}; T${n} is moved back to ${before.slice(0, 7)}: re-run it sequential`);
    };
    // The task's Test files at the landed tip (the phase tip). A file that is not there is a failure, never a pass with zero files
    // run; so are a non-zero exit and a run that outlives the timeout. A green run is ledgered: `Tested: T<N> <sha>`.
    const runTests = ({ tests, root, timeout }, landedSha, before) => {
      const missing = tests.find((t) => !existsSync(resolve(root, t)));
      if (missing !== undefined) undo(`landing failed: the Test file ${missing} is not in the landed tree`, before);
      const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => key !== 'NODE_TEST_CONTEXT'));
      const ran = common.exec(process.execPath, ['--test', ...tests.map((t) => resolve(root, t))], { cwd: root, env, timeout });
      const log = join(workspace, `task-${n}-landing-test.log`);
      writeFileSync(log, `${ran.stdout}${ran.stderr}`);
      if (ran.timedOut) undo(`landing failed: node --test did not finish in ${timeout} ms at the landed tip (output so far in ${log})`, before);
      if (ran.status !== 0) undo(`landing failed: node --test exited ${ran.status} at the landed tip (output in ${log})`, before);
      common.appendLedger(workspace, `Tested: T${n} ${landedSha}`);
    };

    const land = () => {
      const context = preflight();
      const { tip } = context;
      if (!common.isAncestor(base, head)) {
        throw new ScriptError(EXIT_REFUSED, `the BASE of T${n} (${base.slice(0, 7)}) is not an ancestor of its head ${head.slice(0, 7)}: the worktree was not made from it, so it cannot be landed`);
      }
      const first = common.git(['rev-list', '--reverse', `${base}..${head}`]).split('\n')[0];
      const [name, email, date, message] = common.git(['log', '--format=%an%x00%ae%x00%aI%x00%B', '-1', first]).split('\0');

      // A crash after the reset and before the `Landed:` line leaves the tip at a commit that already is the landing of this head
      // (the merge of the head onto the tip's parent is the tip's tree, with the first commit's author and message): record it,
      // do not land a second, empty commit on top of it.
      const parent = common.commitOf(`${tip}^`);
      const same = (rev) => common.git(['log', '--format=%an%x00%ae%x00%B', '-1', rev]).split('\0');
      const alreadyLanded = () => {
        if (parent === null) return false;
        const prior = common.exec('git', ['merge-tree', '--write-tree', `--merge-base=${base}`, parent, head]);
        return prior.status === 0 && prior.stdout.split('\n')[0].trim() === common.git(['rev-parse', `${tip}^{tree}`])
          && same(tip).join('\0') === [name, email, message].join('\0');
      };
      let before = tip;
      let landedSha;
      if (alreadyLanded()) {
        before = parent;
        landedSha = tip;
      } else {
        const merged = common.exec('git', ['merge-tree', '--write-tree', '--name-only', `--merge-base=${base}`, tip, head]);
        if (merged.status === 1) {
          const files = merged.stdout.split('\n').slice(1).map((l) => l.trim()).filter((l, i, all) => l !== '' && all.slice(0, i).every((p) => p !== ''));
          undo(`landing conflict in ${files.join(', ') || 'the merge'}`, tip);
        }
        if (merged.status !== 0) throw new ScriptError(EXIT_OTHER, `git merge-tree: ${common.firstLine(merged.stderr) || `exited ${merged.status}`}`);
        const tree = merged.stdout.split('\n')[0].trim();
        landedSha = common.git(['commit-tree', tree, '-p', tip, '-F', '-'], {
          input: `${message}\n`,
          env: { ...process.env, GIT_AUTHOR_NAME: name, GIT_AUTHOR_EMAIL: email, GIT_AUTHOR_DATE: date },
        });
        common.git(['reset', '--keep', landedSha]);
      }
      common.appendLedger(workspace, `Landed: T${n} ${landedSha}`);
      const lastPrep = common.prepsOf(window, n).at(-1);
      if (lastPrep) common.appendLedger(workspace, `Prep: T${n} r${lastPrep.round} ${landedSha}`);
      runTests(context, landedSha, before);
      return landedSha;
    };

    // A landing that stands (a rerun) is trusted only after the checks a crash can leave undone: it is still on the active phase
    // branch, and its Test files passed (else they run again; a failure is undone).
    // The two refusals below clear by no rerun: the way out is the abandon recipe of the SKILL's Refusals section.
    const abandon = () => `; the owner decides: to abandon this landing follow the Refusals section of the executing-plans SKILL.md (with the sha the owner names, reset the phase branch to it, write \`BASE: T${n} <sha>\` and \`Task ${n}: landing conflict — re-run sequential\`, create the file task-${n}-undone, remove the worktree and its branch), then re-run T${n} sequential`;
    const verifyLanding = (landedSha) => {
      const phaseBranch = common.activePhaseBranch(plan);
      const phaseTip = common.commitOf(`refs/heads/${phaseBranch}`);
      if (phaseTip === null || !common.isAncestor(landedSha, phaseTip)) {
        // The undo of a landing resets the phase branch first and writes its ledger lines after: a landing with no `Tested:` line whose
        // phase branch is back at its parent is an undo that died between the two. Finish it (the lines, the marker, the task moved back,
        // the worktree removed) and refuse, as the undo does. A tested landing was never undone by the script: that stays an owner's call.
        const before = common.commitOf(`${landedSha}^`);
        if (phaseTip !== null && before === phaseTip && !common.isTested(window, n, landedSha)) {
          undo(`the undo of the landing of T${n} was cut short after its reset; it is finished now`, before, { reset: false });
        }
        throw new ScriptError(EXIT_REFUSED, `the landed commit ${landedSha.slice(0, 7)} of T${n} is not on the phase branch ${phaseBranch} (the undo of the landing may have been cut short): nothing is closed${abandon()}`);
      }
      if (common.isTested(window, n, landedSha)) return;
      if (landedSha !== phaseTip) {
        throw new ScriptError(EXIT_REFUSED, `the landed commit ${landedSha.slice(0, 7)} of T${n} has no Tested: line and is not the tip of ${phaseBranch}: its Test files cannot be run again here${abandon()}`);
      }
      const before = common.commitOf(`${landedSha}^`);
      if (before === null) throw new ScriptError(EXIT_OTHER, `the landed commit ${landedSha.slice(0, 7)} of T${n} has no parent`);
      runTests(preflight(), landedSha, before);
    };

    // The commit a squash starts after. The first attempt's is BASE. A reopened task (attempt 2 and later) squashes from the parent of the
    // commit its previous close made: for a task closed in place that is its BASE, but a landed worktree task's BASE is the phase tip
    // from when it opened, older than the tip it landed on, and a squash from there would fold the tasks closed since into its commit.
    // A previous close that made no commit (its line reads <sha>..<sha>) left the branch at that sha. A previous commit that is not in the
    // history of HEAD is an Error, never a fall back to BASE.
    const squashBase = () => {
      if (attempt === 1) return base;
      const line = ledger[earlier.at(-1)];
      const m = /commits ([0-9a-f]{7,40})\.\.([0-9a-f]{7,40})[,)]/.exec(line);
      const opened = m && common.commitOf(m[1]);
      const closed = m && common.commitOf(m[2]);
      if (!closed || !common.isAncestor(closed, head)) {
        throw new ScriptError(EXIT_OTHER, `the commit of T${n}'s previous close (${m ? m[2] : line}) is not in the history of HEAD: a reopen cannot tell where its squash starts`);
      }
      if (opened === closed) return closed;
      const parent = common.commitOf(`${closed}^`);
      if (parent === null) throw new ScriptError(EXIT_OTHER, `the commit of T${n}'s previous close (${closed.slice(0, 7)}) has no parent`);
      return parent;
    };

    // ---- write: land or squash, done, the complete line, the record, the entry ----
    let sha;
    let closeBase = base;
    if (resumed) {
      sha = resumedSha;
    } else {
      if (worktreeTask) {
        if (landed !== null) verifyLanding(landed);
        if (landed === null && noCommits) {
          // Nothing to land: the task closes at the tip of the phase branch, as a task closed in place closes at HEAD. Its own head is its
          // BASE, older than every task that closed since it opened, and a Phase check reopen would squash from there and fold them in.
          sha = common.commitOf(`refs/heads/${common.activePhaseBranch(plan)}`);
          if (sha === null) throw new ScriptError(EXIT_OTHER, 'cannot resolve the tip of the active phase branch');
          closeBase = sha;
        } else sha = landed ?? land();
      } else {
        closeBase = squashBase();
        const squashed = common.runScript('stack.mjs', ['squash', plan, closeBase]);
        if (squashed.status !== 0) throw common.scriptError('stack.mjs squash', squashed);
        const printed = squashed.stdout.trim();
        sha = printed === 'no commits' ? common.git(['rev-parse', 'HEAD']) : printed;
      }
      if (state && state.status !== 'done') common.taskMove('done', n, plan, ['--commit', sha]);
      common.appendLedger(workspace, `Task ${n}: complete (commits ${closeBase.slice(0, 7)}..${sha.slice(0, 7)}, ${parked > 0 ? `${parked} parked` : 'review clean'})`);
    }

    // The close marker of this attempt (see the header): the cutoff for the next attempt's outputs.
    if (!existsSync(markerOf(attempt))) writeFileSync(markerOf(attempt), `${sha}\n`);

    const recordFile = join(workspace, `task-${n}-record.json`);
    writeFileSync(recordFile, `${JSON.stringify(record, null, 2)}\n`);
    const recorded = common.exec('triqual', ['role-eval', 'record', '--plan', plan, recordFile]);
    if (recorded.status !== 0) throw new ScriptError(EXIT_OTHER, `triqual role-eval record: ${recorded.stderr.split('\n').find((l) => l.trim() !== '')?.trim() ?? `exited ${recorded.status}`}`);
    const said = recorded.stdout.trim();
    if (said !== 'recorded' && said !== 'already recorded') throw new ScriptError(EXIT_OTHER, `triqual role-eval record: unexpected output: ${said}`);

    // The review entry, in the tracking mode of the repo.
    if (optedIn && (mode === 'store' || mode === 'local')) {
      const short = sha.slice(0, 7);
      const title = `T${n} review closed at ${short}`;
      // Only a rerun can find the entry already there. A failed lookup is an Error, never "no entry yet".
      const entryPresent = () => {
        if (mode === 'local') {
          const text = progress && existsSync(progress) ? readText(progress, 'the progress file') : '';
          return text.split('\n').some((l) => new RegExp(`^## \\d{4}-\\d{2}-\\d{2} — ${title}\\s*$`).test(l));
        }
        const logged = common.exec('triqual', ['tracking', 'log', '--plan', stem, '--grep', title, '--json']);
        if (logged.status !== 0) throw new ScriptError(EXIT_OTHER, `triqual tracking log: ${logged.stderr.split('\n').find((l) => l.trim() !== '')?.trim() ?? `exited ${logged.status}`}`);
        let rows;
        try {
          rows = JSON.parse(logged.stdout);
        } catch {
          rows = null;
        }
        if (!Array.isArray(rows)) throw new ScriptError(EXIT_OTHER, 'triqual tracking log: the output is not a JSON array');
        return rows.length > 0;
      };
      if (!(resumed && entryPresent())) {
        const draft = join(workspace, `task-${n}-close-entry.md`);
        const found = (h) => `${h.category} ${sum(h.confirmed)} confirmed of ${h.candidates}${h.failed ? ' (failed)' : ''}`;
        writeFileSync(draft, [
          `## ${record.at.slice(0, 10)} — ${title}`,
          `- **Stage/task:** Plan ${stem} · T${n} · review`,
          `- **Done:** T${n} reviewed at tier ${tier} (attempt ${attempt}) and squashed to ${short}; the task-review record is ${said}.`,
          '- **Files:** none (review bookkeeping)',
          `- **Verification:** gate findings ${record.gate.findings}; spec ${spec ? SEVERITIES.map((s) => `${s} ${spec.findings[s]}`).join(', ') : 'did not run'}; hunters ${hunters.length ? hunters.map(found).join('; ') : 'none'}; fix rounds ${record.fixRounds}.`,
          '- **Next:** the next task of the phase.',
          '',
        ].join('\n'));
        const added = mode === 'store'
          ? common.exec('triqual', ['tracking', 'add', draft, '--commit', sha])
          : common.exec('triqual', ['tracking', 'write', 'entry', draft]);
        if (added.status !== 0) throw new ScriptError(EXIT_OTHER, `triqual tracking: ${added.stderr.split('\n').find((l) => l.trim() !== '')?.trim() ?? `exited ${added.status}`}`);
      }
    }
    if (worktreeTask) {
      const dropped = common.removeWorktree(wt, { dropUntracked: true });
      if (dropped.length > 0) {
        const more = dropped.length - NAMED_UNTRACKED_MAX;
        process.stderr.write(`removed the worktree ${wt.path} with ${dropped.length} untracked file${dropped.length === 1 ? '' : 's'}: ${dropped.slice(0, NAMED_UNTRACKED_MAX).join(', ')}${more > 0 ? `, and ${more} more` : ''}\n`);
      }
    }
    process.stdout.write(`sha: ${sha}\nrecord: ${said}\n`);
  } catch (e) {
    const err = e instanceof ScriptError ? e : new ScriptError(1, `${STEP}: ${e.message}`);
    common.fail(STEP, n, err.code, err.message, err.logged ? workspace : undefined);
  }
})().catch((e) => {
  process.stderr.write(`task-close: ${e.stack ?? e}\n`);
  process.exit(1);
});
