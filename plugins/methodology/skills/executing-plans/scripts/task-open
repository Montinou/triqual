#!/usr/bin/env node
// Start a task in one call: the `start` move on the tracking ledger (when the repo is opted in and the task is not
// started already), the task's brief, and the task's BASE.
//
// Usage: task-open PLAN_FILE N [--worktree]
// Prints, in this order:
//   brief: <workspace>/task-<N>-brief.md   (written)
//   report: <workspace>/task-<N>-report.md (the implementer's report file; not created)
//   base: <sha>                            (the LAST `BASE: T<N> <sha>` ledger line; recorded from HEAD when there is none; for a
//                                           --worktree task from the last CLOSED commit of HEAD's branch, so a main-checkout
//                                           task's unreviewed commits are never its base)
//   workdir: <path>                        (only with --worktree: the task's worktree)
//
// With --worktree the task is built in `.claude/worktrees/<plan stem>-t<N>` on the branch `wt/<plan stem>-t<N>`, made from BASE (the
// last closed commit of the phase branch: the phase tip, or the BASE of a main-checkout task whose commits no close has squashed yet), so tasks of one phase can run side by side and land in plan order (task-close). A worktree that
// is already there is reused. `.claude/worktrees/` is appended to `.git/info/exclude` when absent. The install command is chosen
// from the worktree's lockfile (`package-lock.json` -> `npm ci`, `pnpm-lock.yaml` -> `pnpm install --frozen-lockfile`, `yarn.lock` ->
// `yarn install --frozen-lockfile`, none -> no install) and runs in the worktree; a run whose install succeeded leaves a marker in the
// worktree's git dir, so a rerun installs again only after a failed install. A task whose plan has no `Test:` path, or a `Test:`
// path that is not a .mjs, .js or .cjs file, a glob, or a path outside the repository (one that climbs out of it), is refused (exit 3) before anything
// is written: landing runs those files with `node --test`, and a landing that runs no test is no landing.
//
// A task that is in progress, in review or done is not moved again; a task that is pending is started; any
// other state (dropped) is refused, and so is a blocked one: only the human's decision restarts it, with `triqual tasks start`. BASE is recorded right after the move and before the brief, so a rerun after a failed brief reuses it. A
// task the tracking ledger shows as started with no `BASE:` line (a 1.1.0 ledger resumed mid-task) is refused: its first
// commit is not HEAD, and HEAD as BASE would close it with no review. Run from the main checkout.
//
// A coordinator task (the plan's `**Role:** coordinator`) opened in the main checkout is refused (exit 3) while an earlier task of its phase
// is not done or dropped: it starts like a batch task, once nothing earlier is open in the main checkout.
//
// Exit codes: 0 ok, 2 usage / no such plan file / malformed plan, 3 refused (linked worktree, unknown task, a started task
// with no BASE line, a blocked task, a coordinator task with an earlier task open, a move the ledger refuses), 1 any other failure. A failure appends `Error: task-open T<N> — exit <code> — <cause>` to the ledger.
//
// Dynamic imports only: the file has no extension, so Node may load it as CommonJS or as an ES module depending on the
// nearest package.json.
(async () => {
  const { existsSync, realpathSync, writeFileSync } = await import('node:fs');
  const { basename, dirname, join } = await import('node:path');
  const { pathToFileURL } = await import('node:url');
  const common = await import(pathToFileURL(join(dirname(realpathSync(process.argv[1])), 'lib', 'task-common.mjs')).href);
  const { ScriptError, EXIT_USAGE, EXIT_REFUSED } = common;

  const STEP = 'task-open';
  const USAGE = 'usage: task-open PLAN_FILE N [--worktree]';
  const LOCKFILES = [
    ['package-lock.json', ['npm', 'ci']],
    ['pnpm-lock.yaml', ['pnpm', 'install', '--frozen-lockfile']],
    ['yarn.lock', ['yarn', 'install', '--frozen-lockfile']],
  ];
  const STARTABLE = ['pending'];
  const STARTED = ['in_progress', 'in_review', 'done'];
  let n = null;
  let workspace;
  try {
    const argv = process.argv.slice(2);
    const worktree = argv.includes('--worktree');
    const [plan, taskArg, ...extra] = argv.filter((a) => a !== '--worktree');
    n = common.taskNumber(taskArg);
    if (plan === undefined || n === null || extra.length > 0) throw new ScriptError(EXIT_USAGE, USAGE);
    common.assertMainCheckout();
    workspace = common.workspaceOf(plan);
    const planTask = common.readPlanTask(plan, n);
    if (worktree) {
      const tests = common.testPaths(planTask);
      if (tests.length === 0) throw new ScriptError(EXIT_REFUSED, `T${n} has no Test: path in the plan: a worktree task lands only after its Test files pass`);
      const bad = tests.find((t) => !/\.(mjs|js|cjs)$/.test(t));
      if (bad) throw new ScriptError(EXIT_REFUSED, `T${n}: the Test: path ${bad} is not a .mjs, .js or .cjs file, which node --test runs at landing`);
      const root = common.git(['rev-parse', '--show-toplevel']);
      const problem = tests.map((t) => common.testPathProblem(root, t)).find((why) => why !== null);
      if (problem) throw new ScriptError(EXIT_REFUSED, `T${n}: ${problem}, and landing runs each one with node --test`);
    }

    const planName = basename(plan);
    // A coordinator task works in the main checkout and starts like a batch task: its BASE is HEAD and its close squashes BASE..HEAD, so an
    // earlier task still open there would have its unreviewed commits absorbed (or its review package hold the coordinator's commit).
    if (!worktree && planTask.task.role === 'coordinator') {
      const waiting = common.earlierUnfinished(plan, planName, n, common.ledgerLines(workspace));
      if (waiting.length > 0) {
        throw new ScriptError(EXIT_REFUSED, `T${n} is a coordinator task and works in the main checkout: it starts once every earlier task of the phase is done or dropped (${waiting.map((m) => `T${m}`).join(', ')} ${waiting.length === 1 ? 'is' : 'are'} not)`);
      }
    }
    const state = common.taskState(planName, n);
    if (state && state.status === 'blocked') throw new ScriptError(EXIT_REFUSED, `T${n} is blocked: only your human partner's decision restarts it, with triqual tasks start T${n}`);
    if (state && !STARTABLE.includes(state.status) && !STARTED.includes(state.status)) throw new ScriptError(EXIT_REFUSED, `T${n} is ${state.status}; cannot start`);

    let base = common.lastBase(common.ledgerLines(workspace), n);
    if (base === null && state && STARTED.includes(state.status)) {
      throw new ScriptError(EXIT_REFUSED, `no BASE recorded for a started task (T${n} is ${state.status}): append "BASE: T${n} <sha>" to ${join(workspace, 'sdd-ledger.md')}, the sha being the commit before the task's first commit`);
    }
    if (state && STARTABLE.includes(state.status)) common.taskMove('start', n, plan);
    // BASE goes in before the brief: a brief that fails must not leave the rerun to take a later HEAD.
    if (base === null) {
      base = worktree ? common.worktreeBase(planName, n, common.ledgerLines(workspace)) : common.git(['rev-parse', 'HEAD']);
      common.appendLedger(workspace, `BASE: T${n} ${base}`);
    }

    let workdir = null;
    if (worktree) {
      const wt = common.worktreeOf(planName, n);
      common.excludeWorktrees();
      if (!common.registeredWorktrees().includes(wt.path)) {
        // The branch of an earlier worktree of the task is reused; a new one starts at BASE.
        const branched = common.commitOf(`refs/heads/${wt.branch}`) !== null;
        common.git(['worktree', 'add', ...(branched ? [wt.path, wt.branch] : ['-b', wt.branch, wt.path, base])]);
      }
      const marker = join(common.git(['rev-parse', '--path-format=absolute', '--git-dir'], { cwd: wt.path }), 'triqual-installed');
      const lockfile = LOCKFILES.find(([name]) => existsSync(join(wt.path, name)));
      if (lockfile && !existsSync(marker)) {
        const [command, ...args] = lockfile[1];
        const installed = common.exec(command, args, { cwd: wt.path });
        if (installed.status !== 0) throw new ScriptError(1, `${lockfile[1].join(' ')}: ${common.firstLine(installed.stderr) || `exited ${installed.status}`}`);
        writeFileSync(marker, `${lockfile[1].join(' ')}\n`);
      }
      workdir = wt.path;
    }

    const brief = join(workspace, `task-${n}-brief.md`);
    const made = common.runScript('task-brief', [plan, String(n), brief]);
    if (made.status !== 0) throw common.scriptError('task-brief', made);
    process.stdout.write(`brief: ${brief}\nreport: ${join(workspace, `task-${n}-report.md`)}\nbase: ${base}\n${workdir ? `workdir: ${workdir}\n` : ''}`);
  } catch (e) {
    const err = e instanceof ScriptError ? e : new ScriptError(1, `${STEP}: ${e.message}`);
    common.fail(STEP, n, err.code, err.message, workspace);
  }
})().catch((e) => {
  process.stderr.write(`task-open: ${e.stack ?? e}\n`);
  process.exit(1);
});
