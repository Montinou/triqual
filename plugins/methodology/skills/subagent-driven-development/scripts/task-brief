#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.methodology/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking marketplace packages (#2040).
  dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

# Fences follow the rule of progress-tracking's parsePlan (lib/ledger.mjs), so
# both see the same tasks: a run of 3+ backticks or tildes indented under four
# columns (a tab counts as four) opens a fence; after backticks the rest of the
# line may not hold a backtick. Only a run of the same character, at least as
# long as the opener, with nothing but blanks after it, closes the fence.
awk -v n="$n" '
  function fence_line(line,   i, c, w, rest) {
    w = 0
    for (i = 1; i <= length(line); i++) {
      c = substr(line, i, 1)
      if (c == " ") w += 1
      else if (c == "\t") w += 4
      else break
    }
    if (w >= 4) return 0
    rest = substr(line, i)
    f_char = substr(rest, 1, 1)
    if (f_char != "`" && f_char != "~") return 0
    f_len = 0
    while (substr(rest, f_len + 1, 1) == f_char) f_len++
    if (f_len < 3) return 0
    f_info = substr(rest, f_len + 1)
    return !(f_char == "`" && index(f_info, "`") > 0)
  }
  {
    line = $0
    sub(/\r$/, "", line)
    if (fence_len > 0) {
      if (fence_line(line) && f_char == fence_char && f_len >= fence_len && f_info ~ /^[ \t]*$/) fence_len = 0
    } else if (fence_line(line)) {
      fence_char = f_char
      fence_len = f_len
    } else if (line ~ /^#+[ \t]+Task[ \t]+[0-9]+/) {
      intask = (line ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
    }
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
