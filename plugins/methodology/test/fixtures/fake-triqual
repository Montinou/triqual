#!/usr/bin/env bash
# A `triqual` stand-in for script tests. Put it first on PATH under the name `triqual`.
#   FAKE_TRIQUAL_LOG    file that receives one line per call: the argv, space-joined
#                       (the name it was invoked under, `triqual` or `cm`, goes to "$FAKE_TRIQUAL_LOG.argv0")
#   FAKE_TRIQUAL_EXIT   when set, every call exits with this status (2: an older progress-tracking that is not opted
#                       in; 3: the shim without progress-tracking)
#   FAKE_TRIQUAL_PATHS  the JSON `triqual tasks paths --json` prints
#   FAKE_TRIQUAL_STATUS the JSON `triqual tasks status --json` prints (default: `[]`, no ledger)
# Any other call succeeds and prints `fake-triqual: <argv>`.
set -u

if [ -n "${FAKE_TRIQUAL_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_TRIQUAL_LOG"
  printf '%s\n' "${0##*/}" >> "$FAKE_TRIQUAL_LOG.argv0"
fi

if [ -n "${FAKE_TRIQUAL_EXIT:-}" ]; then
  echo "fake-triqual: exit $FAKE_TRIQUAL_EXIT" >&2
  exit "$FAKE_TRIQUAL_EXIT"
fi

if [ "$*" = "tasks paths --json" ]; then
  printf '%s\n' "${FAKE_TRIQUAL_PATHS:?FAKE_TRIQUAL_PATHS is not set}"
  exit 0
fi

if [ "$*" = "tasks status --json" ]; then
  printf '%s\n' "${FAKE_TRIQUAL_STATUS:-[]}"
  exit 0
fi

echo "fake-triqual: $*"
