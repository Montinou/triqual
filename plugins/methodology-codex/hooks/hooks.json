{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/triqual-hook\" session-start --harness codex", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/triqual-hook\" stop --harness codex", "timeout": 60 }
        ]
      }
    ]
  }
}
